FROM nginx:alpine

COPY nginx.conf /etc/nginx/nginx.conf

# STEP 3 CHANGE (F-07): TLS enabled. The certificate and private key are
# mounted at runtime from ./certs (read-only) instead of being copied into
# the image, so the private key never ends up inside an image layer or a
# registry. See gen_certs.sh.
RUN mkdir -p /etc/nginx/certs
